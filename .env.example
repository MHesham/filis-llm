# Copy to .env and fill in, or generate both keys at once:
#   umask 077 && printf 'VLLM_API_KEY=%s\nWEBUI_SECRET_KEY=%s\n' "$(openssl rand -hex 32)" "$(openssl rand -hex 32)" > .env
VLLM_API_KEY=replace-with-random-hex
WEBUI_SECRET_KEY=replace-with-random-hex

# Optional: put Open WebUI behind your own domain instead of the thundercompute.net
# URL, via Cloudflare Tunnel. Leave both blank to keep using the infra-assigned URL.
# See "Custom domain (Cloudflare Tunnel)" in README.md for how to get the token.
PUBLIC_DOMAIN=
CLOUDFLARE_TUNNEL_TOKEN=
